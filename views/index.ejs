
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <title>Demo KUNNA – SSR</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <div class="container-md">
        <h1>Tabla renderizada en el servidor (SSR)</h1>

        <!-- <button id="btn">Cargar datos</button> -->
        <!-- <button id="btn" type="button" class="btn btn-outline-primary">Cargar datos</button>
        <div id="status" class="muted" style="margin-top:.5rem;"></div> -->

        <% if (columns.length && values.length) { %>
            <div id="table" class="table-responsive-md">
                <table class="table table-striped table-sm table-hover">
                <thead>
                <tr>
                    <% columns.forEach(c => { %>
                    <th><%= c %></th>
                    <% }); %>
                </tr>
                </thead>
                <tbody>
                <% values.forEach(row => { %>
                    <tr>
                    <% columns.forEach((_, i) => { %>
                        <td><%= (row[i] && typeof row[i] === 'object') ? JSON.stringify(row[i]) : (row[i] ?? '') %></td>
                    <% }); %>
                    </tr>
                <% }); %>
                </tbody>
            </table>
          </div>
          <p class="text-muted">Mostrando <%= values.length %> filas.</p>
        <% } else { %>
          <div class="alert alert-warning">Sin datos o formato inesperado.</div>
        <% } %>
    </div>
</body>
</html>
